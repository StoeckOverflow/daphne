// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=transfer_data_props %S/../api/cli/adaptive/map.daphne 2>&1 | FileCheck %s --check-prefix=PLAN --implicit-check-not=daphne.analyzeData --implicit-check-not=daphne.DaphneContext
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=kernels %S/../api/cli/adaptive/map.daphne 2>&1 | FileCheck %s --check-prefix=LOWER --implicit-check-not=_analyzeData__
// RUN: cd %S/../.. && daphne --explain=transfer_data_props,kernels %S/../api/cli/adaptive/map.daphne 2>&1 | FileCheck %s --check-prefix=OFF --implicit-check-not=daphne.analyzeData --implicit-check-not=_analyzeData__

// PLAN-LABEL: IR after transferring data properties:
// PLAN: "daphne.analyzeData"([[INPUT:%[a-zA-Z0-9_]+]],
// PLAN: "daphne.map"([[INPUT]]
// LOWER-LABEL: IR after kernel lowering:
// LOWER: callee = "_analyzeData__
// LOWER: "daphne.map"
// OFF: IR after transferring data properties:
// OFF: "daphne.map"
// OFF: IR after kernel lowering:
// OFF: "daphne.map"
