// Check both operands, no runtime context during planning, and no duplicate insertion in lowering.
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=transfer_data_props %S/../api/cli/adaptive/matmul_sparse.daphne 2>&1 | FileCheck %s --check-prefix=PLAN --implicit-check-not=daphne.analyzeData --implicit-check-not=daphne.DaphneContext
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=kernels %S/../api/cli/adaptive/matmul_sparse.daphne 2>&1 | FileCheck %s --check-prefix=LOWER --implicit-check-not=_analyzeData__
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=transfer_data_props %S/../api/cli/adaptive/matmul_known_density.daphne 2>&1 | FileCheck %s --check-prefix=PLAN --implicit-check-not=daphne.analyzeData --implicit-check-not=daphne.DaphneContext
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=kernels %S/../api/cli/adaptive/matmul_known_density.daphne 2>&1 | FileCheck %s --check-prefix=LOWER --implicit-check-not=_analyzeData__
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=transfer_data_props %S/../api/cli/adaptive/matmul_transposed.daphne 2>&1 | FileCheck %s --check-prefix=PLAN --implicit-check-not=daphne.analyzeData --implicit-check-not=daphne.DaphneContext
// RUN: cd %S/../.. && daphne --adaptiveAnalyze=exact --explain=kernels %S/../api/cli/adaptive/matmul_transposed.daphne 2>&1 | FileCheck %s --check-prefix=LOWER --implicit-check-not=_analyzeData__
// RUN: cd %S/../.. && daphne --explain=transfer_data_props,kernels %S/../api/cli/adaptive/matmul_sparse.daphne 2>&1 | FileCheck %s --check-prefix=OFF --implicit-check-not=daphne.analyzeData --implicit-check-not=_analyzeData__

// PLAN-LABEL: IR after transferring data properties:
// PLAN: "daphne.analyzeData"([[LHS:%[a-zA-Z0-9_]+]],
// PLAN: "daphne.analyzeData"([[RHS:%[a-zA-Z0-9_]+]],
// PLAN: "daphne.matMul"([[LHS]], [[RHS]],

// LOWER-LABEL: IR after kernel lowering:
// LOWER: "daphne.call_kernel"([[LHS:%[a-zA-Z0-9_]+]],{{.*}}callee = "_analyzeData__
// LOWER: "daphne.call_kernel"([[RHS:%[a-zA-Z0-9_]+]],{{.*}}callee = "_analyzeData__
// LOWER: "daphne.call_kernel"([[LHS]], [[RHS]],{{.*}}callee = "_matMul__

// OFF: IR after transferring data properties:
// OFF: "daphne.matMul"
// OFF: IR after kernel lowering:
// OFF: callee = "_matMul__
